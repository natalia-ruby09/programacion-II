    private void btnAgregarActionPerformed(java.awt.event.ActionEvent evt) {                                           
        // TODO add your handling code here:
        String codLibro = txtCodLibro.getText().trim();
        String numPagStr = txtNumPagina.getText().trim();
        String contenido = txtContenido.getText().trim();
        if (codLibro.isEmpty() || numPagStr.isEmpty() || contenido.isEmpty()) {
            txtArea.append("ERROR: Debe llenar todos los campos.\n");
            return;
}

Libro libro = Sistema.buscarLibro(codLibro);
if (libro == null) {
    txtArea.append("ERROR: No existe un libro con ese codigo.\n");
    return;
}

int numPagina;
try {
    numPagina = Integer.parseInt(numPagStr);
} catch (NumberFormatException e) {
    txtArea.append("ERROR: El numero de pagina debe ser un entero.\n");
    return;
}

Pagina p = new Pagina(numPagina, contenido);
libro.agregarPagina(p);

txtArea.append("Pagina agregada correctamente.\n");
    }                                          

    private void btnMostrarActionPerformed(java.awt.event.ActionEvent evt) {                                           
        // TODO add your handling code here:
        String codLibro = txtCodLibro.getText().trim();
        if (codLibro.isEmpty()) {
            txtArea.setText("Debe introducir el codigo del libro.\n");
    return;
}

Libro libro = Sistema.buscarLibro(codLibro);

if (libro == null) {
    txtArea.setText("ERROR: No existe un libro con ese codigo.\n");
    return;
}

txtArea.setText(libro.mostrarPaginas());
    }                                          

