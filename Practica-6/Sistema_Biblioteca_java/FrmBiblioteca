    private void btnCrearActionPerformed(java.awt.event.ActionEvent evt) {                                         
        // TODO add your handling code here:
        try {
        String nombre = jTextField1.getText();
        String dias = jTextField2.getText();
        String apertura = jTextField3.getText();
        String cierre = jTextField4.getText();
        
        Horario h = new Horario(dias, apertura, cierre);
        biblioteca = new Biblioteca(nombre, h);
        
        jTextArea1.setText("Biblioteca creada existosamente\n");
        } catch (Exception e){
            jTextArea1.setText("error al crear la biblioteca: "+ e.getMessage());
        }
    }                                        

