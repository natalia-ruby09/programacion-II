    private void jButton1ActionPerformed(java.awt.event.ActionEvent evt) {                                         
        // TODO add your handling code here:
        try {
            String codigo = jTextField1.getText();
            String titulo = jTextField2.getText();
            String genero = jTextField3.getText();
            int paginas = Integer.parseInt(jTextField4.getText());
            
            libro = new Libro(codigo, titulo, genero, paginas);
            
            Sistema.agregarLibro(libro);
            
            jTextArea1.append("Libro creado y guardado exitosamente.\n");
        } catch (NumberFormatException e){
            jTextArea1.append("ERROR: ingrese un nummero valido en paginas.\n");
        }
    }                                        

