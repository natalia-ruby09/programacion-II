    private void btnCrearAutorActionPerformed(java.awt.event.ActionEvent evt) {                                              
        // TODO add your handling code here:
        try {
            String nombre = jTextField1.getText();
            int edad = Integer.parseInt(jTextField2.getText());
            String nacionalidad = jTextField3.getText();
            
            Autor a = new Autor(nombre, edad, nacionalidad);
            Sistema.agregarAutor(a);
            
            txtArea.append("Autor registrado exitosamente.\n");
        } catch (NumberFormatException e){
            txtArea.append("ERROR: ingrese un numero valido en edad.\n");
        }
    }                                             

