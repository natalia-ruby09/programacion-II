    private void btnCrearActionPerformed(java.awt.event.ActionEvent evt) {                                         
        // TODO add your handling code here:
            String codLibro = txtCodLibro.getText();
    String codEst = txtCodEstudiante.getText();
    String fecha = txtFecha.getText();

    Libro libro = Sistema.buscarLibro(codLibro);
    Estudiante est = Sistema.buscarEstudiante(codEst);

    if (libro == null){
        txtArea.append("ERROR: No existe un libro con ese código.\n");
        return;
    }
    if (est == null){
        txtArea.append("ERROR: No existe un estudiante con ese código.\n");
        return;
    }

    Prestamo p = new Prestamo(libro, est, fecha);
    Sistema.agregarPrestamo(p);
    txtArea.append("Préstamo registrado correctamente.\n");

    }                                        

