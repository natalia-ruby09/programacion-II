    private void btnCrearActionPerformed(java.awt.event.ActionEvent evt) {                                         
        // TODO add your handling code here:
        try {
        String codigo = jTextField1.getText();
        String nombre = jTextField2.getText();
        int edad = Integer.parseInt(jTextField3.getText());
        String carrera = jTextField4.getText();

        Estudiante e = new Estudiante(codigo, nombre, edad, carrera);

        Sistema.agregarEstudiante(e);

        txtArea.append("Estudiante registrado exitosamente.\n");

    } catch (NumberFormatException ex){
        txtArea.append("ERROR: edad debe ser un número entero.\n");}

    }                                        

