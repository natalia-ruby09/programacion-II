package com.mycompany.teleferico;

public class Cabina {
    private final int nroCabina;
    private final Persona[] personasAbordo;

    public Cabina(int nroCabina) {
        this.nroCabina = nroCabina;
        this.personasAbordo = new Persona[10]; 
    }

    public boolean agregarPersona(Persona p) {
        // Verificar cupo
        for (int i = 0; i < personasAbordo.length; i++) {
            if (personasAbordo[i] == null) {

                float pesoActual = obtenerPesoTotal();
                if (pesoActual + p.getPeso() <= 850) {
                    personasAbordo[i] = p;
                    return true;
                }
                return false;
            }
        }
        return false; 
    }

    public float obtenerPesoTotal() {
        float total = 0;
        for (Persona px : personasAbordo) {
            if (px != null) {
                total += px.getPeso();
            }
        }
        return total;
    }

    public int getNroCabina() { 
        return nroCabina; 
    }

    public Persona[] getPersonas() { 
        return personasAbordo; 
    }
}
